# dependencies
node_modules/
.pnpm-store/

# build outputs
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# WXT (Chrome extension) build outputs and generated types
apps/extension/.output/
apps/extension/.wxt/
*.zip

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# env
.env
.env.local
.env.*.local

# media / model artifacts (never commit real media or weights)
*.onnx
*.pt
*.pth
uploads/
tmp/
.model_cache/
.artifacts/

# python tooling
.pytest_cache/
.ruff_cache/

# datasets (license-gated, never commit)
datasets/
eval/data/

# resumable per-sample score cache from the eval harnesses (images, audio)
.score_cache/
.audio_score_cache/

# editor / OS
.vscode/*
!.vscode/extensions.json
# Claude Code session/tooling config -- local to each developer's machine.
.claude/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# eval artifacts (datasets and reports contain no media, but keep caches out)
services/inference/eval/.cache/
